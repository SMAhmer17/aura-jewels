{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aura-jewels-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "aura-jewels-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "start:dev"
      ],
      "port": 4000
    }
  ]
}