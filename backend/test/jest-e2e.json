{
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "moduleFileExtensions": ["js", "json", "ts"],
  "transform": { "^.+\\.ts$": ["ts-jest", { "diagnostics": false }] },
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "testTimeout": 30000
}
