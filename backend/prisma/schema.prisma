generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductStatus {
  active
  draft
  archived
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

enum DiscountType {
  percentage
  fixed
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id             String           @id @default(uuid())
  slug           String           @unique
  name           String
  description    String           @default("")
  price          Int
  compareAtPrice Int?
  categoryId     String?
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  material       String           @default("")
  images         String[]         @default([])
  status         ProductStatus    @default(active)
  featured       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  variants       ProductVariant[]
  reviews        Review[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([status])
}

model ProductVariant {
  id         String      @id @default(uuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String
  stock      Int         @default(0)
  sku        String      @unique
  /// Display order set by the admin (Size 5, Size 6, ...)
  position   Int         @default(0)
  orderItems OrderItem[]

  @@unique([productId, size])
  @@index([productId])
}

model Review {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author        String
  /// Kept private (never sent to the storefront). Used to stop repeat reviews and to confirm the reviewer bought the product.
  email         String?
  title         String?
  rating        Int
  comment       String
  /// True when this email has a non-cancelled order containing the product.
  verifiedBuyer Boolean  @default(false)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([productId, email])
  @@index([productId])
}

enum MessageStatus {
  unread
  read
  resolved
}

/// An inquiry sent from the storefront's contact form. The owner replies by phone or email.
model ContactMessage {
  id          String        @id @default(uuid())
  name        String
  email       String
  phone       String?
  /// Order the inquiry is about, if the customer gave one (e.g. AJ-2026-1001).
  orderNumber String?
  message     String
  status      MessageStatus @default(unread)
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
}

/// The single store admin. Created by the seed script from ADMIN_EMAIL / ADMIN_PASSWORD.
model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Optional customer accounts. Guests can order without one.
model Customer {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Discount {
  id             String       @id @default(uuid())
  code           String       @unique
  type           DiscountType
  value          Int
  active         Boolean      @default(true)
  usageLimit     Int?
  usedCount      Int          @default(0)
  startsAt       DateTime?    @db.Date
  endsAt         DateTime?    @db.Date
  minOrderAmount Int?
  createdAt      DateTime     @default(now())
}

model Order {
  id             String        @id @default(uuid())
  /// Sequential number shown to people as AJ-<year>-<1000 + orderNo>
  orderNo        Int           @unique @default(autoincrement())
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName   String
  email          String
  phone          String
  address        String
  city           String
  subtotal       Int
  shipping       Int
  discountCode   String?
  discountAmount Int           @default(0)
  giftBoxFee     Int           @default(0)
  total          Int
  status         OrderStatus   @default(pending)
  paymentMethod  String        @default("cod")
  paymentStatus  PaymentStatus @default(unpaid)
  notes          String?
  createdAt      DateTime      @default(now())
  items          OrderItem[]
  events         OrderEvent[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([email])
}

/// A snapshot of what was bought, so order history survives later product edits.
model OrderItem {
  id        String          @id @default(uuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name      String
  size      String
  price     Int
  quantity  Int
  /// The product's cover photo when the order was placed, so the order still shows what was bought after edits or deletion.
  image     String?

  @@index([orderId])
}

model OrderEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  createdAt DateTime    @default(now())

  @@index([orderId])
}

/// Single row (id = 1). The whole home page content as JSON, edited from the admin.
model HomeContent {
  id        Int      @id @default(1)
  content   Json
  updatedAt DateTime @updatedAt
}

/// Single row (id = 1).
model Settings {
  id                    Int    @id @default(1)
  storeName             String @default("Aura Jewels")
  tagline               String @default("By ZAS")
  supportEmail          String @default("")
  supportPhone          String @default("")
  shippingFlatRate      Int    @default(250)
  freeShippingThreshold Int    @default(50000)
  giftBoxPrice          Int    @default(300)
  lowStockThreshold     Int    @default(5)
}
