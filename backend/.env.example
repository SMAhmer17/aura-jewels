# Copy to .env and fill in. Never commit .env.

PORT=4000
NODE_ENV=development

# Postgres. Locally this is your own Postgres; in production it is your Supabase project.
# Supabase: DATABASE_URL is the pooled (port 6543, add ?pgbouncer=true) connection the API uses,
# DIRECT_URL is the direct (port 5432) connection used only for migrations.
DATABASE_URL=postgresql://USER@localhost:5432/aura_jewels?schema=public
DIRECT_URL=postgresql://USER@localhost:5432/aura_jewels?schema=public

# Long random string. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# The single admin account, created or updated by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Comma separated list of frontends allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Uploaded product images.
# Local development: kept on this machine's disk and served from PUBLIC_BASE_URL.
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000
# Production (Railway): store them in Supabase Storage instead. Find both in Supabase > Project Settings > API.
# The service role key is a server secret: never put it in the frontend or commit it.
# The bucket is created automatically on the first upload.
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SECRET_KEY=   (the "secret" key, sb_secret_...; the older service_role key also works as SUPABASE_SERVICE_ROLE_KEY)
# SUPABASE_STORAGE_BUCKET=product-images

# Interactive API docs at /api/docs. On by default; set to false to hide them.
# SWAGGER_ENABLED=true
